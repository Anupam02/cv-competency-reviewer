# Default: local Ollama (no cloud API key). Start with: ollama serve
# Pull a model first, e.g. ollama pull llama3.2
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Heuristic-only (tests and offline demos):
# LLM_PROVIDER=none

# Cloud OpenAI instead of Ollama:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Embedding backend: hashed (no download) or sentence-transformers
EMBEDDING_BACKEND=hashed
# SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
